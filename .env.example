# Optional. Public Borealis searches work without a token.
BOREALIS_API_KEY=
BOREALIS_API_BASE_URL=https://borealisdata.ca/api
BOREALIS_TIMEOUT_SECONDS=30
BOREALIS_MAX_FILE_BYTES=5242880
BOREALIS_DEFAULT_MAX_LINES=100

# REST server only
HOST=0.0.0.0
PORT=8000

# Streamable HTTP MCP server only. Defaults are 127.0.0.1 and 8000.
# Bind 0.0.0.0 only behind a tunnel, reverse proxy, or container boundary.
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
